# Images: public on ghcr.io (same CI as github.com/thelonius/adaptive-astro-scheduler).
# Pin a git SHA for reproducibility, or use :latest for simplest Agensi install.
BACKEND_IMAGE=ghcr.io/thelonius/adaptive-astro-scheduler/backend:latest
EPHEMERIS_IMAGE=ghcr.io/thelonius/adaptive-astro-scheduler/ephemeris:latest

# stack-up.sh generates POSTGRES_PASSWORD on first run
POSTGRES_PASSWORD=change-me-after-first-run

ASTRO_BIND_PORT=3000

# Optional: intent mode needs an OpenAI-compatible key on the server
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
