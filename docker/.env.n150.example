# Образец окружения для n150. Скопировать в корень чекаута как .env,
# заполнить и выставить права 600 — секреты в открытом виде на чужой
# машине уже стоили этому проекту угнанного бота.
#
#   cp docker/.env.n150.example .env && chmod 600 .env
#   cp docker/.env.n150.example docker/.env && chmod 600 docker/.env
# compose читает docker/.env при запуске из docker/; держи оба файла в sync

# Образы собираются в CI и лежат в ghcr.io, тянутся без авторизации.
# Тег — полный SHA коммита (CI ставит и latest, но пин на SHA делает
# деплой воспроизводимым). Актуальный: git rev-parse main
BACKEND_IMAGE=ghcr.io/thelonius/adaptive-astro-scheduler/backend:19d3d33017af33b201262cc65fcb0ff5239db4ae
EPHEMERIS_IMAGE=ghcr.io/thelonius/adaptive-astro-scheduler/ephemeris:19d3d33017af33b201262cc65fcb0ff5239db4ae

# Пароль постгреса. Придумать новый, амстердамский сюда не переносить
POSTGRES_PASSWORD=

# Порт на loopback хоста, откуда openclaw читает API. Проверить,
# что свободен: ss -lntp | grep 3000
ASTRO_BIND_PORT=3000

# Толкования от NVIDIA NIM. Без ключа бэкенд поднимется, тексты работать не будут
NVIDIA_API_KEY=
