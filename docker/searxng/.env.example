# Скопировать в .env и chmod 600. Генерация секрета: ./init.sh
SEARXNG_SECRET=

# --- Доступ для клиентов (Mac, телефон, Cursor) — опционально ---
# init-clients.sh + compose --profile clients
#
# LAN Mattahu (Wi‑Fi дома, VPN в сеть 192.168.1.x):
#   SEARXNG_CLIENT_BIND=192.168.1.86:8890
# Только с самого сервера (тест):
#   SEARXNG_CLIENT_BIND=127.0.0.1:8890
#
# Не ставьте 0.0.0.0 без необходимости — откроет порт на всех интерфейсах.
SEARXNG_CLIENT_BIND=192.168.1.86:8890
SEARXNG_CLIENT_USER=search
SEARXNG_CLIENT_PASSWORD=
