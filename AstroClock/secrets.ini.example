; Шаблон личной конфигурации часов.
;
;     cp secrets.ini.example secrets.ini
;
; secrets.ini лежит в .gitignore. Значения ниже нейтральные: эпоха J2000
; в Гринвиче. Прошивка с ними соберётся и пойдёт, но покажет чужую карту.
;
; Учётные данные WiFi сюда не вписываются, они приходят переменными
; окружения через tools/build_flags.py. Пароль в ini-файле рядом с рабочим
; деревом однажды уже уехал в публичный репозиторий.

[personal]
build_flags =
    ; --- натальная карта ---
    -D NATAL_YEAR=2000
    -D NATAL_MONTH=1
    -D NATAL_DAY=1
    -D NATAL_HOUR=12
    -D NATAL_MINUTE=0
    ; Смещение от UTC в часах на момент рождения, с декретным и летним
    ; временем. Москва в сентябре 1984 жила по UTC+4: декретное плюс летнее,
    ; отменённое только 30 сентября.
    -D NATAL_UTC_OFFSET=0.0
    -D NATAL_LAT=0.0
    -D NATAL_LON=0.0
    ; --- где стоят часы ---
    -D HOME_LAT=0.0
    -D HOME_LON=0.0
    ; Часовой пояс в формате POSIX TZ, его понимает configTzTime.
    ; Москва: MSK-3. Амстердам: CET-1CEST,M3.5.0,M10.5.0/3
    -D HOME_TZ='"UTC0"'
